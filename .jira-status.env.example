# Copy this file to .jira-status.env and fill in the non-secret settings.
# The API token and Slack webhook are read from macOS Keychain.

# For a scoped Jira API token, use:
# https://api.atlassian.com/ex/jira/YOUR_CLOUD_ID
# For an unscoped token, use your Jira site URL, such as:
# https://your-company.atlassian.net
JIRA_API_BASE_URL=https://api.atlassian.com/ex/jira/YOUR_CLOUD_ID

# The Atlassian account email associated with the Jira API token.
JIRA_EMAIL=you@example.com

# Optional, for clickable issue links in local ticket files.
JIRA_SITE_URL=https://your-company.atlassian.net
